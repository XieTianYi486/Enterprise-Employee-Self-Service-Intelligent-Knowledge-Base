# ============================================================
# 企业员工自助服务系统 - 环境配置
# 复制此文件为 .env 并修改配置项
# ============================================================

# --- 应用基础配置 ---
APP_NAME=企业员工自助服务系统
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# --- 服务端口 ---
HOST=0.0.0.0
PORT=8000

# --- OA 审批规则（修改后重启生效） ---
LEAVE_BOSS_APPROVAL_DAYS=3.0
EXPENSE_BOSS_APPROVAL_AMOUNT=5000.0

# --- 数据库 ---
# SQLite 默认（无需修改）
DATABASE_URL=sqlite:///./data/enterprise_rag.db

# --- 阿里云百炼（DashScope）---
# 必填！从 https://dashscope.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# 轻量任务（查询改写/重排序）可用更便宜的模型降低费用；留空则跟随 LLM_MODEL
REWRITE_MODEL=
RERANK_MODEL=
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

# --- 检索配置 ---
VECTOR_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=50
RERANK_CANDIDATES=10
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.5
# 查询改写开关（关闭可省一次 LLM 调用，降低首字延迟）
QUERY_REWRITE_ENABLED=true

# --- 分块配置 ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- JWT 认证 ---
# 必填！强随机密钥（可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成）。
# 留空或使用公开占位值会导致启动被拒绝，防止 JWT 可被伪造
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- 缓存 ---
CACHE_TTL_ANSWER=86400
CACHE_TTL_SESSION=3600
# 查询向量缓存 TTL（秒），重复问题不再调用 Embedding API
EMBED_CACHE_TTL=604800

# --- 默认管理员 ---
# 首次启动创建默认管理员时使用；生产部署必须改为强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=admin@company.com
